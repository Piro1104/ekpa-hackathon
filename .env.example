# Copy to .env and fill in locally. Never commit .env.

# LLM: local (Ollama) | cloud (Anthropic, backup only) | mock (tests, no model)
LLM_MODE=local
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=hf.co/ilsp/Llama-Krikri-8B-Instruct-GGUF:Q4_K_M
# Seconds before a call is given up and the template text is kept
LLM_TIMEOUT=60

# Only for LLM_MODE=cloud
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

# Telegram bot (python -m rafi.telegram_bot whoami | brief | run)
# Token from @BotFather. Chat ids: press Start in the bot, then run whoami.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# The phone that plays the customer in the demo
TELEGRAM_CUSTOMER_CHAT_ID=
